# ==============================================================================
# .gitignore — Personal Developer OS
# ==============================================================================

# Documentation & Engineering Specs (Private)
docs/
*.md.backup
NEXTJS_16_UPGRADE.md
DEPENDENCY_UPDATE.md

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing and coverage
coverage/
.nyc_output/

# Next.js & TypeScript build outputs
.next/
out/
build/
dist/
tsconfig.tsbuildinfo

# Vercel & Deployment metadata
.vercel

# Environment variables & secrets (CRITICAL - DO NOT UPLOAD)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env*.local
*.env
!.env.example

# Database backups & SQL dumps (Data leak protection)
*.dump
*.dump.gpg
*.sql.gz
*.backup
backups/
developer-os-backup-*.json

# Drizzle local studio/state
.drizzle/

# Security Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Debug & System logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor metadata
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo

# AI / Agent workspace artifacts
.gemini/
.agents/
