# ==============================================================================
# Personal Developer OS — Environment Configuration Template
# ==============================================================================

# Supabase Public Configuration (Accessible on Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (NEVER expose to client code!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Direct Connection String (For Drizzle ORM & Migrations)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
